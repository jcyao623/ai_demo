 # ============================================
 # AI Demo - Environment Variables
 # Copy this file to .env and fill in values
 # ============================================
 
 # AI 配置已托管到 Nacos 配置中心 (ai-demo-service.yml)
 # 不再需要显式设置 API Key 环境变量
 #
 # Nacos 控制台: http://localhost:8848/nacos
 # 登录账号: nacos / nacos
 #
 # 如需修改 AI 配置，请直接在 Nacos 中编辑 ai-demo-service.yml
 
 # Redis (defaults to localhost:6379)
 SPRING_DATA_REDIS_HOST=localhost
 SPRING_DATA_REDIS_PORT=6379
 
 # Nacos (defaults to localhost:8848)
 SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=127.0.0.1:8848
