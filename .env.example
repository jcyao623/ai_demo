 # ============================================
 # AI Demo - Environment Variables
 # Copy this file to .env and fill in values
 # ============================================
 
 # Spring AI - DashScope (Alibaba Tongyi/Qwen) API Key
 # Get your API key from: https://bailian.console.aliyun.com/
 # Uses OpenAI-compatible mode: https://dashscope.aliyuncs.com/compatible-mode/v1
 DASHSCOPE_API_KEY=your_dashscope_api_key_here
 
 # Redis (defaults to localhost:6379)
 SPRING_DATA_REDIS_HOST=localhost
 SPRING_DATA_REDIS_PORT=6379
 
 # Nacos (defaults to localhost:8848)
 SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR=127.0.0.1:8848
